			"type": "text",
			"x": 80.38782207760755,
			"y": 916.9667874843849,
			"width": 367.3828125,
			"height": 920.7,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"roughness": 0,
			"opacity": 100,
			"angle": 0,
			"text": "[\n  // --- Liens depuis une région du TD ---\n  {\n    \"id\": \"m1\",\n    \"source\": {\n      \"file\": \"td.pdf\",\n      \"region\": {\"p\":1, \"bbox\":[0,0.3,1,1]}\n    },\n    \"target\": {\"file\": \"cours.pdf\",\n               \"region\": {\"p\":15, \"bbox\":[0,0.2,1,0.8]}},\n    \"display\": {\n      \"render\": \"icon\", \"trigger\": \"click\",\n      \"icon\": \"📖\", \"color\": \"#1971c2\"\n    }\n  },\n  {\n    \"id\": \"m2\",\n    \"source\": {\n      \"file\": \"td.pdf\",\n      \"region\": {\"p\":1, \"bbox\":[0,0.3,1,1]}\n    },\n    \"target\": {\"file\": \"exo-1-corr.pdf\"},\n    \"display\": {\n      \"render\": \"panel\", \"trigger\": \"click\",\n      \"icon\": \"✓\", \"color\": \"#2b8a3e\"\n    }\n  },\n  {\n    \"id\": \"m3\",\n    \"source\": {\n      \"file\": \"td.pdf\",\n      \"region\": {\"p\":1, \"bbox\":[0,0.3,1,1]}\n    },\n    \"target\": {\"ref\": \"m10\"},\n    \"display\": {\"render\": \"edge\", \"style\": \"dashed\"}\n  },\n  {\n    \"id\": \"m4\",\n    \"source\": {\n      \"file\": \"td.pdf\",\n      \"region\": {\"p\":1, \"bbox\":[0,0.3,1,1]}\n    },\n    \"target\": {\"repo\": \"prof-dupont/analyse-L1\",\n               \"ref\": \"m42\"},\n    \"display\": {\"render\": \"edge\", \"style\": \"dotted\"}\n  },\n\n  // --- Annotation de région (label) ---\n  {\n    \"id\": \"m5\",\n    \"source\": {\n      \"file\": \"td.pdf\",\n      \"region\": {\"p\":1, \"bbox\":[0,0.3,1,1]}\n    },\n    \"label\": \"Exercice 1 — Périhélie de Mercure\",\n    \"tags\": [\"mécanique\", \"forces-centrales\"],\n    \"difficulty\": 4,\n    \"display\": {\n      \"render\": \"boundary\", \"color\": \"#e67700\"\n    }\n  }\n]",
			"fontSize": 11,
