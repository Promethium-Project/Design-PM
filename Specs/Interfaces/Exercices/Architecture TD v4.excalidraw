					"type": "arrow"
				}
			],
			"updated": 1773142047589,
			"link": null,
			"locked": false,
			"groupIds": [],
			"originalText": "calcul-diff/\n│\n├── cours.pdf\n├── td.pdf\n├── exo-1-corr.pdf                        ← fichier normal, à la racine\n├── exo-5-corr.pdf\n│\n├── .promethium/\n│   ├── meta.json                         ← metadata repo\n│   └── mappings.json                     ← TOUS les liens, PLAT, sans types\n│\n└── social/                               ← UNIFIÉ (ex community/ + guilds/)\n    ├── julien-q001.md                    ← question\n    ├── julien-q001.meta.json             ← si c'était un PDF scanné\n    ├── camille-r001.md                   ← réponse\n    ├── camille-sol-exo1.meta.json        ← metadata du scan\n    ├── camille-sol-exo1-scan.pdf         ← le scan lui-même\n    ├── marie-sol-exo3.md\n    ├── guild-mp123-tip-ch1.md            ← annotation guilde (chiffré)\n    ├── guild-mp123-tip-ch1.enc           ← contenu chiffré\n    ├── guild-mp123-planning.json         ← planning guilde (chiffré)\n    └── stars.json                        ← append-log étoiles",
