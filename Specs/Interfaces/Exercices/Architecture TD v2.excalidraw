		},
		{
			"id": "el_183",
			"type": "text",
			"x": -91.19527714351966,
			"y": 4110.88403001394,
			"width": 394.32241929827615,
			"height": 471.730943455907,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"roughness": 0,
			"opacity": 100,
			"angle": 0,
			"text": "calcul-diff/                    ← REPO SOURCE (prof)\n├── cours.pdf\n├── td.pdf\n└── .promethium/\n    ├── meta.json\n    ├── exercises.json\n    └── corrections/\n\ncalcul-diff-community/          ← REPO COMMUNITY\n├── questions/\n├── solutions/\n└── stars.json\n\nAvantages:\n  + Séparation claire prof / communauté\n  + Le prof contrôle son repo, pas de bruit\n  + Le repo source reste léger\n  + Le community peut être supprimé/recréé\n    sans toucher au contenu pédagogique\n\nInconvénients:\n  - Deux git remote à gérer côté client\n  - Le lien source↔community est une convention\n    (.promethium/source.json) pas un lien natif\n  - PR cross-repo impossible (ex: question qui\n    suggère une correction au prof)\n  - Sparse checkout sur 2 repos = complexité",
			"fontSize": 12.941864017994705,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "top",
			"seed": 623057865,
			"version": 146,
			"versionNonce": 926832647,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1773137183152,
			"link": null,
			"locked": false,
			"groupIds": [],
			"originalText": "calcul-diff/                    ← REPO SOURCE (prof)\n├── cours.pdf\n├── td.pdf\n└── .promethium/\n    ├── meta.json\n    ├── exercises.json\n    └── corrections/\n\ncalcul-diff-community/          ← REPO COMMUNITY\n├── questions/\n├── solutions/\n└── stars.json\n\nAvantages:\n  + Séparation claire prof / communauté\n  + Le prof contrôle son repo, pas de bruit\n  + Le repo source reste léger\n  + Le community peut être supprimé/recréé\n    sans toucher au contenu pédagogique\n\nInconvénients:\n  - Deux git remote à gérer côté client\n  - Le lien source↔community est une convention\n    (.promethium/source.json) pas un lien natif\n  - PR cross-repo impossible (ex: question qui\n    suggère une correction au prof)\n  - Sparse checkout sur 2 repos = complexité",
			"lineHeight": 1.35,
			"containerId": null,
			"autoResize": true,
			"index": "b0K",
			"strokeStyle": "solid",
			"frameId": null,
