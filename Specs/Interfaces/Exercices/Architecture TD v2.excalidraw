			"roughness": 0,
			"opacity": 100,
			"angle": 0,
			"text": "1. check_path_permissions(user, files_changed)\n2. check_frontmatter_author(user, new_md_files)\n3. check_stars_append_only(old_stars, new_stars)\n4. check_guild_membership(user, guild_paths)\n5. check_file_size_limit(files)  ← anti-abus\n6. check_no_binary_in_questions()  ← que du .md",
			"fontSize": 13,
