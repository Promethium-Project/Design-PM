			"roughness": 0,
			"opacity": 100,
			"angle": 0,
			"text": "11. Recommandation: mono-repo + hook pre-receive",
			"fontSize": 28,
			"fontFamily": 1,
			"textAlign": "left",
			"verticalAlign": "top",
			"seed": 59676926,
			"version": 189,
			"versionNonce": 1625601865,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1773137105369,
			"link": null,
			"locked": false,
			"groupIds": [],
			"originalText": "11. Recommandation: mono-repo + hook pre-receive",
			"lineHeight": 1.35,
			"containerId": null,
			"autoResize": true,
			"index": "b1t",
			"strokeStyle": "solid",
			"frameId": null,
