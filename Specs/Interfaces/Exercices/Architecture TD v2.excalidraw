			"fillStyle": "solid",
			"strokeWidth": 1,
			"roughness": 0,
			"opacity": 100,
			"angle": 0,
			"text": "Avec Gitea/Forgejo (self-hosted)",
			"fontSize": 20,
			"fontFamily": 1,
			"textAlign": "left",
			"verticalAlign": "top",
			"seed": 573920142,
			"version": 162,
			"versionNonce": 1042154311,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1773137075043,
			"link": null,
			"locked": false,
			"groupIds": [],
			"originalText": "Avec Gitea/Forgejo (self-hosted)",
			"lineHeight": 1.35,
			"containerId": null,
			"autoResize": true,
			"index": "b1o",
			"strokeStyle": "solid",
			"frameId": null,
			"roundness": null,
			"rawText": ""
		},
		{
			"id": "el_276",
			"type": "text",
			"x": 3020.640749938296,
			"y": 2195.8111765586755,
			"width": 380.859375,
			"height": 368.55,
			"strokeColor": "#495057",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"roughness": 0,
			"opacity": 100,
			"angle": 0,
			"text": "Gitea supporte nativement les \"Protected Branches\"\nmais PAS les permissions par chemin.\n\nSolution: un git hook pre-receive côté serveur\nqui vérifie les chemins modifiés dans chaque push.\n\nPseudo-code du hook:\n  for each file in commit.changed_files:\n    if file.startswith(\"/*.pdf\"):\n      assert user.role == \"prof\"\n    if file.startswith(\"/community/questions/\"):\n      assert user.is_authenticated\n      assert file.author_in_frontmatter == user.id\n    if file.startswith(\"/guilds/guild-X/\"):\n      assert user.is_member(\"guild-X\")\n    if file == \"stars.json\":\n      assert only_appended(old_stars, new_stars)\n      assert new_entry.user == user.id\n\nLe hook rejette le push si une règle est violée.\nL'user reçoit un message d'erreur explicite.",
			"fontSize": 13,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "top",
			"seed": 501902547,
			"version": 130,
			"versionNonce": 1982595687,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1773137075043,
			"link": null,
			"locked": false,
			"groupIds": [],
			"originalText": "Gitea supporte nativement les \"Protected Branches\"\nmais PAS les permissions par chemin.\n\nSolution: un git hook pre-receive côté serveur\nqui vérifie les chemins modifiés dans chaque push.\n\nPseudo-code du hook:\n  for each file in commit.changed_files:\n    if file.startswith(\"/*.pdf\"):\n      assert user.role == \"prof\"\n    if file.startswith(\"/community/questions/\"):\n      assert user.is_authenticated\n      assert file.author_in_frontmatter == user.id\n    if file.startswith(\"/guilds/guild-X/\"):\n      assert user.is_member(\"guild-X\")\n    if file == \"stars.json\":\n      assert only_appended(old_stars, new_stars)\n      assert new_entry.user == user.id\n\nLe hook rejette le push si une règle est violée.\nL'user reçoit un message d'erreur explicite.",
			"lineHeight": 1.35,
			"containerId": null,
			"autoResize": true,
			"index": "b1p",
			"strokeStyle": "solid",
			"frameId": null,
			"roundness": null,
			"rawText": ""
		},
