		{
			"id": "el_285",
			"type": "text",
			"x": 3018.210400746531,
			"y": 3142.8128703770367,
			"width": 525.5859375,
			"height": 807.3000000000001,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"roughness": 0,
			"opacity": 100,
			"angle": 0,
			"text": "calcul-diff/\n│\n├── cours.pdf                          PROF WRITE\n├── td.pdf                             PROF WRITE\n│\n├── .promethium/\n│   ├── meta.json                      PROF WRITE\n│   ├── exercises.json                 PROF WRITE (PR étudiants)\n│   ├── corrections/                   PROF WRITE (accès conditionné)\n│   │   ├── exo-1-corr.pdf\n│   │   └── exo-5-corr.pdf\n│   └── mappings/\n│       └── td-to-cours.json           PROF WRITE\n│\n├── community/\n│   ├── questions/                     AUTH WRITE (son .md)\n│   │   ├── exo-1/\n│   │   │   ├── q-001.md\n│   │   │   └── q-002.md\n│   │   └── exo-3/\n│   │       └── q-003.md\n│   ├── solutions/                     AUTH WRITE (son .md + scan)\n│   │   ├── exo-1/\n│   │   │   ├── camille-sol.md\n│   │   │   └── camille-sol-scan.pdf\n│   │   └── exo-3/\n│   │       └── marie-sol.md\n│   └── stars.json                     AUTH APPEND-ONLY\n│\n├── guilds/\n│   ├── guild-mp-123/                  MEMBRES WRITE\n│   │   ├── annotations/\n│   │   │   └── chapter-1-tips.md\n│   │   ├── solutions/\n│   │   │   └── julien-exo-5-sol.md\n│   │   └── planning.json\n│   └── guild-pc-456/                  MEMBRES WRITE\n│       └── ...\n│\n├── .gitignore                         ← exclut personal/\n└── (en local uniquement, pas dans le repo:)\n    .promethium/personal/\n    ├── progress.json\n    ├── notes/\n    ├── solutions/\n    └── anchors.json",
