		},
		{
			"id": "el_281",
			"type": "rectangle",
			"x": 3003.8593396670403,
			"y": 2761.5378171482184,
			"width": 1190,
			"height": 267.0643637963667,
			"strokeColor": "#2b8a3e",
			"backgroundColor": "#ebfbee",
			"fillStyle": "solid",
			"strokeWidth": 3,
			"roughness": 0,
			"opacity": 40,
			"angle": 0,
			"strokeStyle": "solid",
			"roundness": {
