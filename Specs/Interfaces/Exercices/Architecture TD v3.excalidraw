			"originalText": "Hook pre-receive (pseudo-code)",
			"lineHeight": 1.35,
			"containerId": null,
			"autoResize": true,
			"index": "b0C",
			"strokeStyle": "solid",
			"frameId": null,
			"roundness": null,
			"rawText": ""
		},
		{
			"id": "v3_76",
			"type": "text",
			"x": 119.66462513996225,
			"y": 4048.6553049867607,
			"width": 450,
			"height": 664.2000000000002,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"roughness": 0,
			"opacity": 100,
			"angle": 0,
			"text": "def pre_receive(user, commits):\n  for commit in commits:\n    for file in commit.changed_files:\n\n      # Contenu prof: seul le propriétaire\n      if file in [\"*.pdf\",\"*.promethium/mappings.json\",\n                   \".promethium/meta.json\"]:\n        assert user == repo.owner\n        # SAUF si c'est une PR (review par le prof)\n\n      # Community: tout user authentifié, son .md\n      if file.startswith(\"community/\") and file.endswith(\".md\"):\n        if file_is_new(file):\n          frontmatter = parse_frontmatter(file)\n          assert frontmatter.author == user.id\n        else:\n          # Modification: seul l'auteur original\n          old_fm = parse_frontmatter(file, old_version)\n          assert old_fm.author == user.id\n\n      # Stars: append-only\n      if file == \"community/stars.json\":\n        old = json.load(old_version)\n        new = json.load(new_version)\n        assert is_append_only(old, new)\n        new_entries = diff(old, new)\n        for entry in new_entries:\n          assert entry.user == user.id\n\n      # Guilds: membres seulement\n      if file.startswith(\"guilds/\"):\n        guild_id = extract_guild_id(file)\n        assert user.is_member(guild_id)\n\n      # Taille max par fichier (anti-abus)\n      assert file.size < MAX_FILE_SIZE\n\n      # Pas de binaire dans community/ sauf scans\n      if file.startswith(\"community/\"):\n        if is_binary(file):\n          assert file.endswith((\".pdf\",\".png\",\".jpg\"))",
			"fontSize": 12,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "top",
			"seed": 108181890,
			"version": 243,
			"versionNonce": 482068519,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1773140046739,
			"link": null,
			"locked": false,
			"groupIds": [],
			"originalText": "def pre_receive(user, commits):\n  for commit in commits:\n    for file in commit.changed_files:\n\n      # Contenu prof: seul le propriétaire\n      if file in [\"*.pdf\",\"*.promethium/mappings.json\",\n                   \".promethium/meta.json\"]:\n        assert user == repo.owner\n        # SAUF si c'est une PR (review par le prof)\n\n      # Community: tout user authentifié, son .md\n      if file.startswith(\"community/\") and file.endswith(\".md\"):\n        if file_is_new(file):\n          frontmatter = parse_frontmatter(file)\n          assert frontmatter.author == user.id\n        else:\n          # Modification: seul l'auteur original\n          old_fm = parse_frontmatter(file, old_version)\n          assert old_fm.author == user.id\n\n      # Stars: append-only\n      if file == \"community/stars.json\":\n        old = json.load(old_version)\n        new = json.load(new_version)\n        assert is_append_only(old, new)\n        new_entries = diff(old, new)\n        for entry in new_entries:\n          assert entry.user == user.id\n\n      # Guilds: membres seulement\n      if file.startswith(\"guilds/\"):\n        guild_id = extract_guild_id(file)\n        assert user.is_member(guild_id)\n\n      # Taille max par fichier (anti-abus)\n      assert file.size < MAX_FILE_SIZE\n\n      # Pas de binaire dans community/ sauf scans\n      if file.startswith(\"community/\"):\n        if is_binary(file):\n          assert file.endswith((\".pdf\",\".png\",\".jpg\"))",
			"lineHeight": 1.35,
			"containerId": null,
			"autoResize": true,
			"index": "b0D",
			"strokeStyle": "solid",
