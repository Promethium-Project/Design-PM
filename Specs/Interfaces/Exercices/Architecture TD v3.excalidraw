			"roughness": 0,
			"opacity": 100,
			"angle": 0,
			"text": "[\n  // === SPLITS (remplace exercises.json) ===\n  {\n    \"id\": \"split-1\",\n    \"type\": \"split\",\n    \"source\": \"td.pdf\",\n    \"region\": {\"page_start\":1, \"page_end\":2,\n               \"bbox_start\":[0,0.3,1,1],\n               \"bbox_end\":[0,0,1,0.6]},\n    \"label\": \"Exercice 1 — Périhélie de Mercure\",\n    \"tags\": [\"mécanique\", \"forces-centrales\"],\n    \"difficulty\": 4,\n    \"links\": [\n      {\"target\":\"cours.pdf#p15\", \"type\":\"course-link\"},\n      {\"target\":\"split-0\", \"type\":\"prerequisite\"},\n      {\"target\":\"exo-1-corr.pdf\", \"type\":\"correction\"}\n    ]\n  },\n\n  // === COURSE LINKS (inter-documents) ===\n  {\n    \"id\": \"clink-1\",\n    \"type\": \"course-link\",\n    \"source\": \"td.pdf\",\n    \"region\": {\"page\":2, \"bbox\":[0.1,0.5,0.9,0.6]},\n    \"target\": \"cours.pdf\",\n    \"target_region\": {\"page\":15, \"bbox\":[0,0.2,1,0.8]}\n  },\n\n  // === PREREQUISITES (inter-repo) ===\n  {\n    \"id\": \"prereq-1\",\n    \"type\": \"prerequisite\",\n    \"source\": \"meta\",           // le repo entier\n    \"target_repo\": \"prof-dupont/analyse-L1\",\n    \"target_ref\": \"split-12\"    // un split dans l'autre repo\n  }\n]",
			"fontSize": 12,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "top",
