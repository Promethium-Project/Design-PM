			"roughness": 0,
			"opacity": 100,
			"angle": 0,
			"text": "calcul-diff/\n│\n├── cours.pdf                             ← contenu prof\n├── td.pdf                                ← contenu prof\n├── exo-1-corr.pdf                        ← correction prof (fichier normal)\n├── exo-5-corr.pdf                        ← pas dans .promethium/, c'est du contenu\n│\n├── .promethium/\n│   ├── meta.json                         ← metadata du repo\n│   │   {\"subject\":\"Maths\", \"tags\":[...],\n│   │    \"author\":\"prof-dupont\"}\n│   │\n│   └── mappings.json                     ← TOUT vit ici\n│       [\n│         {id:\"split-1\", type:\"split\",\n│          source:\"td.pdf\", region:{p:1,bbox:[...]},\n│          label:\"Exercice 1\",\n│          tags:[\"dérivabilité\"],\n│          links:[\n│            {target:\"cours.pdf#p15\", type:\"course-link\"},\n│            {target:\"split-0\", type:\"prerequisite\"},\n│            {target:\"exo-1-corr.pdf\", type:\"correction\"}\n│          ]},\n│         {id:\"split-2\", ...},\n│         ...\n│       ]\n│\n├── community/                            ← STRUCTURE PLATE\n│   ├── julien-q001.md                    ← question sur le TD\n│   ├── camille-r001.md                   ← réponse à julien-q001\n│   ├── prof-r002.md                      ← prof répond aussi\n│   ├── camille-sol-exo1.md               ← solution exo 1\n│   ├── camille-sol-exo1-scan.pdf         ← scan joint\n│   ├── marie-sol-exo3.md                 ← solution exo 3\n│   ├── julien-q002.md                    ← autre question\n│   ├── luc-r003.md                       ← réponse à julien-q002\n│   └── stars.json                        ← append-log des étoiles\n│\n├── guilds/\n│   └── guild-mp-123/\n│       ├── camille-tip-ch1.md            ← même format que community/\n│       ├── julien-exo5-sol.md\n│       └── planning.json\n│\n└── .gitignore                            ← exclut personal/",
			"fontSize": 12,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "top",
			"seed": 72639975,
			"version": 2,
			"versionNonce": 495648329,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1773138858315,
			"link": null,
			"locked": false,
			"groupIds": [],
