			"link": null,
			"locked": false,
			"groupIds": [],
			"originalText": "D'où vient chaque élément dans la vue exercice",
			"lineHeight": 1.35,
			"containerId": null,
			"autoResize": true,
			"index": "b0O",
			"strokeStyle": "solid",
			"frameId": null,
			"roundness": null,
