    {
      "id": "cfvSkKLj14krJMSiLxUpX",
      "type": "text",
      "x": -8466.84172036926,
      "y": 1191.4959322249574,
      "width": 972.0488346744568,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c11K",
      "roundness": null,
      "seed": 2918927,
      "version": 177,
      "versionNonce": 694198543,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1756066952619,
      "link": null,
      "locked": false,
      "text": "Calculer le temps maximal qu’une comète de masse m peut passer à l’intérieur de l’orbite, supposée\ncirculaire, de la Terre. La ré référence d’´énergie mécanique est prise nulle à l’infini pour une masse\nimmobile. On suppose\nque l’énergie mécanique de la comète est nulle (trajectoire parabolique).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Calculer le temps maximal qu’une comète de masse m peut passer à l’intérieur de l’orbite, supposée circulaire, de la Terre. La ré référence d’´énergie mécanique est prise nulle à l’infini pour une masse immobile. On suppose\nque l’énergie mécanique de la comète est nulle (trajectoire parabolique).",
      "autoResize": false,
      "lineHeight": 1.25
    },
