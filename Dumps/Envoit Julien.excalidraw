    {
      "id": "hFJwPjoDNMtqMjIpM1GV_",
      "type": "text",
      "x": 1275.0742310894198,
      "y": 8373.916348322435,
      "width": 1386.494873046875,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0St",
      "roundness": null,
      "seed": 849111194,
      "version": 436,
      "versionNonce": 1161697926,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1756049522294,
      "link": null,
      "locked": false,
      "text": "2 façons de faire : \n- 1ere, juste balancer plein de formats exercices dans un dossier, on peut clique droit sur le dossier, et les compiler, pour avoir un seul document TD\n- 2eme, on a un document TD (tappé à la main, où généré à partir d'un PDF), et on peut clique droit le définir comme \"TD\", ça créer un dossier lié à ce document et ça le découpe",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2 façons de faire : \n- 1ere, juste balancer plein de formats exercices dans un dossier, on peut clique droit sur le dossier, et les compiler, pour avoir un seul document TD\n- 2eme, on a un document TD (tappé à la main, où généré à partir d'un PDF), et on peut clique droit le définir comme \"TD\", ça créer un dossier lié à ce document et ça le découpe",
      "autoResize": true,
      "lineHeight": 1.25
    },
